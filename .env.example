# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_TOPIC=analytics-events
KAFKA_CONSUMER_GROUP=analytics-platform
KAFKA_DLQ_TOPIC=analytics-events-dlq

# ClickHouse
CLICKHOUSE_DSN=tcp://localhost:9000/analytics?username=default&password=

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_CACHE_TTL=300

# API
API_PORT=8080
API_READ_TIMEOUT=30s
API_WRITE_TIMEOUT=30s

# Worker
WORKER_BATCH_SIZE=1000
WORKER_FLUSH_INTERVAL=5s

# Metrics
METRICS_PORT=9090

# Logging
LOG_LEVEL=info
